// Cloudflare Workers con static assets: cada push a main publica site/.
// El dominio y la 404 se definen aquí. Ojo: quitar un dominio de este fichero
// NO lo borra en Cloudflare (sin "routes" el deploy no toca los existentes);
// para quitarlo de verdad, también en el panel (Worker cv → Domains & Routes).
{
  "name": "cv",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cv.turolol.win", "custom_domain": true }
  ],
  // Solo cv.turolol.win: sin copia duplicada en *.workers.dev
  "workers_dev": false,
  "preview_urls": false
}
